<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="495.0" prefWidth="1005.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.easydish.easydish.Settings">
    <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="495.0" prefWidth="1005.0">
        <HBox alignment="CENTER" prefHeight="75.0" prefWidth="1005.0">
            <Label alignment="CENTER" contentDisplay="CENTER" ellipsisString="" prefHeight="50.0" prefWidth="200.0" styleClass="settings-title" text="SETTINGS" textOverrun="CLIP" />
            <Button ellipsisString="" mnemonicParsing="false" onAction="#saveSettings" prefHeight="50.0" prefWidth="50.0" textOverrun="CLIP">
                <styleClass>
                    <String fx:value="sidebar-button" />
                    <String fx:value="save-button" />
                </styleClass>
            </Button>
        </HBox>
        <Separator prefWidth="200.0">
            <styleClass>
                <String fx:value="separator" />
                <String fx:value="separator-horizontal" />
            </styleClass>
        </Separator>
        <HBox prefHeight="50.0" prefWidth="200.0">
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </VBox.margin>
            <Region prefHeight="50.0" prefWidth="12.0" />
            <Label fx:id="generatedRecipeAmount" ellipsisString="" prefHeight="50.0" prefWidth="325.0" styleClass="settings-content" text="Generated Recipe Amount - XX" textOverrun="CLIP">
                <HBox.margin>
                    <Insets />
                </HBox.margin>
            </Label>
            <Slider fx:id="amountSlider" max="25.0" min="1.0" minorTickCount="25" nodeOrientation="LEFT_TO_RIGHT" prefHeight="50.0" prefWidth="250.0" snapToTicks="true" />
        </HBox>
        <HBox prefHeight="50.0" prefWidth="200.0">
            <Region prefHeight="50.0" prefWidth="12.0" />
            <Label ellipsisString="" prefHeight="50.0" prefWidth="100.0" styleClass="settings-content" text="UI Theme" textOverrun="CLIP" />
            <Region prefHeight="50.0" prefWidth="25.0" />
            <ToggleButton fx:id="lightButton" ellipsisString="" mnemonicParsing="false" onAction="#toggleTheme" prefHeight="50.0" prefWidth="75.0" text="Light" textOverrun="CLIP">
                <styleClass>
                    <String fx:value="settings-content-minor" />
                    <String fx:value="settings-tab-button" />
                </styleClass>
                <toggleGroup>
                    <ToggleGroup fx:id="uiTheme" />
                </toggleGroup>
            </ToggleButton>
            <Region prefHeight="50.0" prefWidth="12.0" />
            <ToggleButton fx:id="darkButton" ellipsisString="" mnemonicParsing="false" onAction="#toggleTheme" prefHeight="50.0" prefWidth="75.0" text="Dark" textOverrun="CLIP" toggleGroup="$uiTheme">
                <styleClass>
                    <String fx:value="settings-content-minor" />
                    <String fx:value="settings-tab-button" />
                </styleClass>
            </ToggleButton>
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </VBox.margin>
        </HBox>
        <Button alignment="CENTER" ellipsisString="" mnemonicParsing="false" onAction="#clearIngredients" prefHeight="50.0" text="Clear Saved Ingredients" textOverrun="CLIP">
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </VBox.margin>
            <styleClass>
                <String fx:value="settings-content" />
                <String fx:value="settings-tab-button" />
            </styleClass>
        </Button>
        <Button alignment="CENTER" ellipsisString="" mnemonicParsing="false" onAction="#clearRecipes" prefHeight="50.0" text="Clear Saved Recipes" textOverrun="CLIP">
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </VBox.margin>
            <styleClass>
                <String fx:value="settings-content" />
                <String fx:value="settings-tab-button" />
            </styleClass>
        </Button>
        <Button alignment="CENTER" ellipsisString="" mnemonicParsing="false" onAction="#contactUs" prefHeight="50.0" text="Contact Us!" textOverrun="CLIP">
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </VBox.margin>
            <styleClass>
                <String fx:value="settings-content" />
                <String fx:value="settings-tab-button" />
            </styleClass>
        </Button>
        <TextField fx:id="apiKey" prefHeight="50.0" promptText="Custom API Key" styleClass="settings-content-field">
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </VBox.margin>
        </TextField>
    </VBox>
</AnchorPane>

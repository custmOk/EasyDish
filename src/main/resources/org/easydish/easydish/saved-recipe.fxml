<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="64.0"
           prefWidth="336.0" styleClass="transparent" xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.easydish.easydish.SavedRecipeController">
    <HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="54.0"
          prefWidth="326.0" styleClass="saved-content">
        <ImageView fx:id="recipeImageView" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true"
                   styleClass="recipe-image">
            <HBox.margin>
                <Insets left="10.0" right="5.0"/>
            </HBox.margin>
            <Image url="@images/RedCrossError.png"/>
        </ImageView>
        <Label fx:id="recipeLabel" alignment="CENTER" onMouseClicked="#showRecipeInfo" prefHeight="50.0"
               prefWidth="187.0" styleClass="saved-text" text="Label">
            <HBox.margin>
                <Insets left="5.0" right="5.0"/>
            </HBox.margin>
        </Label>
        <Button ellipsisString="" mnemonicParsing="false" onAction="#removeButton" prefHeight="50.0" prefWidth="50.0"
                textOverrun="CLIP">
            <styleClass>
                <String fx:value="sidebar-button"/>
                <String fx:value="minus-button"/>
            </styleClass>
            <HBox.margin>
                <Insets left="5.0" right="10.0"/>
            </HBox.margin>
        </Button>
    </HBox>
</StackPane>

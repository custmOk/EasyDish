<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.easydish.easydish.EasyDishController">
    <BorderPane prefHeight="720.0" prefWidth="1280.0">
        <left>
            <VBox prefHeight="520.0" prefWidth="150.0" styleClass="sidebar-button-container" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                </padding>
                <Button ellipsisString="" mnemonicParsing="false" onAction="#searchButton" textOverrun="CLIP">
                    <VBox.margin>
                        <Insets bottom="25.0" top="25.0" />
                    </VBox.margin>
                    <styleClass>
                        <String fx:value="sidebar-button" />
                        <String fx:value="search-button" />
                    </styleClass>
                </Button>
                <Button ellipsisString="" layoutX="48.0" layoutY="257.0" mnemonicParsing="false" onAction="#bagButton" textOverrun="CLIP">
                    <VBox.margin>
                        <Insets bottom="25.0" top="25.0" />
                    </VBox.margin>
                    <styleClass>
                        <String fx:value="sidebar-button" />
                        <String fx:value="bag-button" />
                    </styleClass>
                </Button>
                <Button ellipsisString="" layoutX="48.0" layoutY="307.0" mnemonicParsing="false" onAction="#bookButton" textOverrun="CLIP">
                    <VBox.margin>
                        <Insets bottom="25.0" top="25.0" />
                    </VBox.margin>
                    <styleClass>
                        <String fx:value="sidebar-button" />
                        <String fx:value="recipe-button" />
                    </styleClass>
                </Button>
                <Button ellipsisString="" layoutX="48.0" layoutY="357.0" mnemonicParsing="false" onAction="#calendarButton" textOverrun="CLIP">
                    <VBox.margin>
                        <Insets bottom="25.0" top="25.0" />
                    </VBox.margin>
                    <styleClass>
                        <String fx:value="sidebar-button" />
                        <String fx:value="calendar-button" />
                    </styleClass>
                </Button>
                <Button ellipsisString="" layoutX="48.0" layoutY="382.0" mnemonicParsing="false" onAction="#settingsButton" textOverrun="CLIP">
                    <VBox.margin>
                        <Insets bottom="25.0" top="25.0" />
                    </VBox.margin>
                    <styleClass>
                        <String fx:value="sidebar-button" />
                        <String fx:value="settings-button" />
                    </styleClass>
                </Button>
            </VBox>
        </left>
        <top>
            <HBox prefHeight="125.0" prefWidth="1278.0" BorderPane.alignment="CENTER">
                <ImageView fx:id="logoImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                    <HBox.margin>
                        <Insets left="25.0" />
                    </HBox.margin>
                    <Image url="@images/light/Logo.jpg" />
                </ImageView>
                <Text styleClass="title" text="EasyDish">
                    <HBox.margin>
                        <Insets left="50.0" />
                    </HBox.margin>
                </Text>
            </HBox>
        </top>
        <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
        </padding>
        <center>
            <AnchorPane prefHeight="545.0" prefWidth="1055.0" BorderPane.alignment="CENTER">
                <BorderPane.margin>
                    <Insets left="25.0" />
                </BorderPane.margin>
                <StackPane fx:id="contentArea" prefHeight="545.0" prefWidth="1055.0" AnchorPane.rightAnchor="0.0" />
            </AnchorPane>
        </center>
    </BorderPane>
    <Separator layoutX="25.0" layoutY="150.0" maxHeight="3.0" minHeight="3.0" prefHeight="3.0" prefWidth="1230.0" styleClass="separator-horizontal" />
    <Separator layoutX="175.0" layoutY="175.0" maxWidth="3.0" minWidth="3.0" orientation="VERTICAL" prefHeight="520.0" prefWidth="3.0" styleClass="separator-vertical" />
</AnchorPane>

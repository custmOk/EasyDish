<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox maxHeight="50.0" maxWidth="1055.0" minHeight="50.0" minWidth="1055.0" nodeOrientation="LEFT_TO_RIGHT"
      prefHeight="50.0" prefWidth="1055.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.easydish.easydish.ListedRecipeController">
    <stylesheets>
        <URL value="@dark-mode.css"/>
    </stylesheets>
    <ImageView fx:id="recipeImageView" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" styleClass="recipe-image">
        <HBox.margin>
            <Insets left="25.0"/>
        </HBox.margin>
        <Image url="@images/RedCrossError.png"/>
    </ImageView>
    <Region prefHeight="50.0" prefWidth="25.0"/>
    <Label fx:id="recipeTitle" onMouseClicked="#showRecipeInfo" prefHeight="50.0" prefWidth="670.0"
           styleClass="recipe-text-name" text="Recipe #1" textAlignment="CENTER"/>
    <Button ellipsisString="" mnemonicParsing="false" onAction="#saveButton" prefHeight="50.0" prefWidth="50.0"
            textOverrun="CLIP">
        <styleClass>
            <String fx:value="sidebar-button"/>
            <String fx:value="plus-button"/>
        </styleClass>
    </Button>
    <Region prefHeight="50.0" prefWidth="25.0"/>
    <Label fx:id="recipeLikes" ellipsisString="" prefHeight="50.0" prefWidth="70.0" styleClass="recipe-text" text="XX"
           textAlignment="CENTER" textOverrun="CLIP"/>
    <Region prefHeight="50.0" prefWidth="70.0"/>
    <Label fx:id="recipeStatus" ellipsisString="" prefHeight="50.0" prefWidth="70.0" styleClass="recipe-text" text="XX"
           textAlignment="CENTER" textOverrun="CLIP"/>
</HBox>
